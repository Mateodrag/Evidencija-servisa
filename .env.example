# Ove varijable postavi SAMO kad hostaš aplikaciju online (npr. na Renderu).
# Za lokalno pokretanje na tvom računalu (POKRENI.command) ostavi ih prazne/nepostavljene -
# aplikacija će tada sama koristiti lokalnu SQLite datoteku (data/fleet.db).

# URL Turso baze (dobiješ ga na app.turso.tech kad napraviš bazu), npr:
# DATABASE_URL=libsql://evidencija-vozila-tvojkorisnik.turso.io

# Pristupni token za Turso bazu (generira se na app.turso.tech)
# DATABASE_AUTH_TOKEN=...
